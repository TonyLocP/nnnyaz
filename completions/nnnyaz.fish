# Fish completion for nnnyaz.
#
# Install: copy to ~/.config/fish/completions/nnnyaz.fish.

complete -c nnnyaz -s h -l help -d 'Print help and exit'
complete -c nnnyaz -s V -l version -d 'Print the version and exit'
complete -c nnnyaz -l generate-config -d 'Print a commented default config.toml and exit'
complete -c nnnyaz -l check-config -d 'Report config warnings and exit (1 if any)'
complete -c nnnyaz -l cwd-file -r -a '(__fish_complete_path)' -d 'Write cwd here on Q'
complete -c nnnyaz -l chooser-file -r -a '(__fish_complete_path)' -d 'Write chosen paths here'
complete -c nnnyaz -s p -r -a '(__fish_complete_path)' -d 'Alias for --chooser-file'
complete -c nnnyaz -s 0 -l null -d 'Separate picker paths with NUL'
complete -c nnnyaz -s H -l hidden -d 'Show hidden files at startup'
complete -c nnnyaz -s i -l file-info -d 'Show hovered file type'
complete -c nnnyaz -s d -l detail -d 'Start in detail linemode'
complete -c nnnyaz -s U -l owner -d 'Start in owner linemode'
complete -c nnnyaz -s J -l no-auto-advance -d 'Keep cursor after toggling selection'
complete -c nnnyaz -s b -l bookmark -r -d 'Start in a bookmark'
complete -c nnnyaz -s Q -l no-confirm-quit -d 'Quit without task warning'
complete -c nnnyaz -s o -l open-on-enter -d 'Only Enter opens files'
complete -c nnnyaz -s n -l type-to-nav -d 'Start in type-to-nav mode'
complete -c nnnyaz -s A -l no-autoenter -d 'Do not auto-enter lone directory'
complete -c nnnyaz -s g -l regex -d 'Use regex filters'
complete -c nnnyaz -s z -l fuzzy -d 'Use fuzzy filters'
complete -c nnnyaz -s e -l editor -d 'Open text files in $VISUAL/$EDITOR/vi'
complete -c nnnyaz -s E -l internal-editor -d 'Use $EDITOR for internal edits'
complete -c nnnyaz -s c -l cli-opener -d 'Run NNN_OPENER in the terminal'
complete -c nnnyaz -s f -l history -d 'Keep a shell command history'
complete -c nnnyaz -s K -l key-collisions -d 'Report keymap collisions and exit'
complete -c nnnyaz -s u -l use-selection -d 'Compatibility no-op'
complete -c nnnyaz -s R -l no-rollover -d 'Compatibility no-op'
complete -c nnnyaz -s s -l session -r -d 'Load a session (@ is last)'
complete -c nnnyaz -s S -l persistent-session -d 'Save session on exit'
complete -c nnnyaz -s T -l sort -r -a 'a d s e t v A D S E T V' -d 'Sort order'
complete -c nnnyaz -s l -l scroll -r -d 'Mouse wheel lines'
complete -c nnnyaz -s t -l lock-after -r -d 'Idle lock timeout in seconds'
complete -c nnnyaz -a '(__fish_complete_path)' -d 'Starting directory or file'
